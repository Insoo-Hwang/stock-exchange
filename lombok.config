# 이 파일이 프로젝트의 Lombok 규칙이다. 상위 폴더의 lombok.config는 읽지 않는다.
config.stopBubbling = true

# 도메인 객체의 상태는 메서드(fill, cancel, reserve …)로만 바꾼다.
# @Data와 @Setter는 아무 필드나 바꿀 수 있는 setter를 만들어 이 규칙을 깨므로 컴파일 에러로 막는다.
lombok.data.flagUsage = error
lombok.setter.flagUsage = error

# Lombok이 만든 코드에 @Generated를 붙여 테스트 커버리지 측정에서 제외되게 한다.
lombok.addLombokGeneratedAnnotation = true
